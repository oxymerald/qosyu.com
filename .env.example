# ================= QOSYU: настройки окружения =================
# Скопируйте в .env и заполните. Файл .env НИКОГДА не коммитится в git.

# development | production
ENVIRONMENT=development

# Порт, на котором сайт будет доступен на хост-машине
BACKEND_PORT=8080

# --- База данных ---
POSTGRES_USER=qosyu
POSTGRES_PASSWORD=придумайте-надёжный-пароль
POSTGRES_DB=qosyu

# Render/Supabase only (Docker Compose continues to use its local db service).
# Paste the Session pooler URI from Supabase Connect, port 5432.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# DATABASE_SCHEMA=qosyu
# DATABASE_SSL=true
# DATABASE_POOL_SIZE=2
# DATABASE_MAX_OVERFLOW=1
# Optional trusted CA downloaded from your Supabase dashboard:
# DATABASE_SSL_CA_FILE=/etc/secrets/supabase-ca.crt

# --- Безопасность ---
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Первичный администратор (создаётся при первом старте) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public contacts shown in the footer and pilot section. Leave unused fields empty.
CONTACT_LOCATION=
CONTACT_LOCATION_EN=
CONTACT_LOCATION_KK=
# International number; spaces are allowed for display.
CONTACT_PHONE=
CONTACT_EMAIL=
# Profile handles, with or without @. Telegram uses a leading @.
CONTACT_INSTAGRAM=
CONTACT_TIKTOK=
CONTACT_TELEGRAM=
# Optional international phone number, digits with an optional leading +.
CONTACT_WHATSAPP=

# --- Telegram-бот (получите НОВЫЙ токен у @BotFather; старый скомпрометирован) ---
TELEGRAM_BOT_TOKEN=

# --- Маршрутизация ---
# По умолчанию — публичный демо-сервер OSRM (работает из коробки, для пилота).
# Для production поднимите свой OSRM или укажите свой инстанс.
# При недоступности OSRM маршрут строится встроенной эвристикой (без карты дорог).
OSRM_BASE_URL=https://router.project-osrm.org
# Депо переработчика по умолчанию (Атырау)
DEPOT_LAT=47.1167
DEPOT_LON=51.8833

# --- AI-ассистент (Google AI Studio / Gemini) ---
# Ключ хранится только на сервере. На Windows можно использовать configure-apis.cmd.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DGIS_API_KEY=
DGIS_MATRIX_ENABLED=true
# Global budget: 24 matrix requests / 24 hours, up to 81 billed cells each.
DGIS_MATRIX_DAILY_REQUESTS=24
