# ================= QOSYU: настройки окружения =================
# Скопируйте в .env и заполните. Файл .env НИКОГДА не коммитится в git.

# development | production
ENVIRONMENT=development

# Порт, на котором сайт будет доступен на хост-машине
BACKEND_PORT=8080

# --- База данных ---
POSTGRES_USER=qosyu
POSTGRES_PASSWORD=придумайте-надёжный-пароль
POSTGRES_DB=qosyu

# --- Безопасность ---
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Первичный администратор (создаётся при первом старте) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Telegram-бот (получите НОВЫЙ токен у @BotFather; старый скомпрометирован) ---
TELEGRAM_BOT_TOKEN=

# --- Маршрутизация ---
# По умолчанию — публичный демо-сервер OSRM (работает из коробки, для пилота).
# Для production поднимите свой OSRM или укажите свой инстанс.
# При недоступности OSRM маршрут строится встроенной эвристикой (без карты дорог).
OSRM_BASE_URL=https://router.project-osrm.org
# Депо переработчика по умолчанию (Атырау)
DEPOT_LAT=47.1167
DEPOT_LON=51.8833

# --- AI-ассистент и рекомендации (Claude) ---
# Ключ: https://platform.claude.com → API Keys. Без ключа платформа работает,
# AI-виджет просто скрыт.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# --- Web Push (необязательно; сгенерируйте VAPID-пару: npx web-push generate-vapid-keys) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=info@qosyu.kz
